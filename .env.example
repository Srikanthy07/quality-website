# =========================================================
# IAST Quality Management System - Production Environment Configuration
# Copy this file to '.env' in production environments and supply real credentials.
# DO NOT commit real secrets, private keys, or passwords to Git.
# =========================================================

# Active Spring Profile (set to 'prod' or 'production' for strict security)
SPRING_PROFILES_ACTIVE=prod

# Server Port (default: 8093 or 443 for HTTPS)
PORT=443

# SSL/HTTPS Enabled flag (true/false)
SSL_ENABLED=true

# Database Connection Parameters
DB_URL=jdbc:mysql://<PRODUCTION_DB_HOST>:3306/quality_website?useSSL=true&requireSSL=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=<PRODUCTION_DB_USERNAME>
DB_PASSWORD=<PRODUCTION_DB_PASSWORD>

# Hibernate DDL Auto Validation Mode (use 'validate' or 'none' for production)
DDL_AUTO=validate

# Persistent Remember-Me Key (generate a strong random secret key)
REMEMBER_ME_KEY=<GENERATE_STRONG_SECRET>

# Allowed CORS Origins (comma-separated list of production origins, no trailing slash, no wildcards)
ALLOWED_ORIGINS=https://quality.iast.com

# SSL Certificate & Private Key Pem Contents (or paths if configuring keystores)
SSL_CERTIFICATE=<PRODUCTION_CERTIFICATE>
SSL_CERTIFICATE_PRIVATE_KEY=<PRODUCTION_PRIVATE_KEY>

# SMTP Mail Server Configuration
MAIL_HOST=<SMTP_HOST>
MAIL_PORT=587
MAIL_USERNAME=<SMTP_USERNAME>
MAIL_PASSWORD=<SMTP_PASSWORD>

# Feedback Form Recipient & Sender Configuration
FEEDBACK_RECIPIENTS=<REAL_RECIPIENT>
FEEDBACK_FROM_EMAIL=<REAL_SENDER>

# Application Base URL (used for password reset email links)
# Local Dev (HTTPS on 8093): APP_BASE_URL=https://localhost:8093
# Production: APP_BASE_URL=https://quality.iast.com
APP_BASE_URL=https://quality.iast.com
